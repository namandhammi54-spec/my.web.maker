<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- =========================
     EDIT HERE: WEBSITE TITLE
========================= -->
<title>Namam Studio | Digital Creative Services</title>

<meta name="description"
content="Professional video editing, thumbnail design and website development services.">

<style>

/* =====================================================
   GLOBAL
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

:root{
    --bg:#070b14;
    --bg2:#0d1322;
    --card:#111827;
    --text:#f8fafc;
    --muted:#94a3b8;
    --primary:#7c3aed;
    --secondary:#06b6d4;
    --green:#22c55e;
    --border:rgba(255,255,255,.10);
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.6;
}

a{
    text-decoration:none;
    color:inherit;
}

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
}

section{
    padding:100px 0;
}


/* =====================================================
   NAVBAR
===================================================== */

.navbar{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:999;
    background:rgba(7,11,20,.80);
    backdrop-filter:blur(15px);
    border-bottom:1px solid var(--border);
}

.nav{
    height:75px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:24px;
    font-weight:800;
}

.logo span{
    color:var(--secondary);
}

.nav-links{
    display:flex;
    gap:28px;
    align-items:center;
}

.nav-links a{
    color:#cbd5e1;
    font-size:15px;
    transition:.3s;
}

.nav-links a:hover{
    color:white;
}

.nav-btn{
    padding:11px 18px;
    background:linear-gradient(135deg,var(--primary),var(--secondary));
    border-radius:8px;
    color:white!important;
    font-weight:bold;
}

.menu-btn{
    display:none;
    font-size:28px;
    cursor:pointer;
}


/* =====================================================
   HERO
===================================================== */

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    padding-top:100px;
    position:relative;
    overflow:hidden;
}

.hero::before{
    content:"";
    position:absolute;
    width:500px;
    height:500px;
    background:var(--primary);
    filter:blur(180px);
    opacity:.25;
    top:-150px;
    left:-150px;
}

.hero-content{
    max-width:850px;
    position:relative;
    z-index:2;
}

.badge{
    display:inline-block;
    padding:8px 16px;
    border:1px solid var(--border);
    background:rgba(255,255,255,.05);
    border-radius:30px;
    color:#c4b5fd;
    margin-bottom:25px;
    font-size:14px;
}

.hero h1{
    font-size:clamp(45px,7vw,82px);
    line-height:1.05;
    margin-bottom:25px;
    letter-spacing:-3px;
}

.gradient-text{
    background:linear-gradient(90deg,#a78bfa,#22d3ee);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.hero p{
    max-width:700px;
    color:var(--muted);
    font-size:19px;
    margin-bottom:35px;
}

.hero-buttons{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    display:inline-block;
    padding:15px 25px;
    border-radius:10px;
    font-weight:bold;
    transition:.3s;
}

.btn-primary{
    background:linear-gradient(135deg,var(--primary),var(--secondary));
}

.btn-secondary{
    border:1px solid var(--border);
    background:rgba(255,255,255,.05);
}

.btn:hover{
    transform:translateY(-3px);
}


/* =====================================================
   STATS
===================================================== */

.stats{
    margin-top:70px;
    display:flex;
    gap:50px;
    flex-wrap:wrap;
}

.stat h3{
    font-size:30px;
}

.stat p{
    color:var(--muted);
}


/* =====================================================
   SECTION TITLE
===================================================== */

.section-title{
    text-align:center;
    max-width:700px;
    margin:0 auto 55px;
}

.section-title .small{
    color:#22d3ee;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:2px;
    font-size:13px;
}

.section-title h2{
    font-size:45px;
    margin:10px 0;
}

.section-title p{
    color:var(--muted);
}


/* =====================================================
   SERVICES
===================================================== */

.services-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.service-card{
    background:linear-gradient(145deg,#111827,#0b1220);
    border:1px solid var(--border);
    border-radius:18px;
    padding:35px;
    transition:.4s;
}

.service-card:hover{
    transform:translateY(-10px);
    border-color:rgba(124,58,237,.6);
}

.service-icon{
    width:60px;
    height:60px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(124,58,237,.15);
    border-radius:14px;
    font-size:28px;
    margin-bottom:25px;
}

.service-card h3{
    font-size:23px;
    margin-bottom:12px;
}

.service-card p{
    color:var(--muted);
}

.service-card ul{
    list-style:none;
    margin-top:20px;
}

.service-card li{
    margin:9px 0;
    color:#cbd5e1;
}


/* =====================================================
   ABOUT
===================================================== */

.about{
    background:var(--bg2);
}

.about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
}

.about-box{
    padding:40px;
    border:1px solid var(--border);
    border-radius:20px;
    background:rgba(255,255,255,.03);
}

.about-box h3{
    font-size:32px;
    margin-bottom:20px;
}

.about-box p{
    color:var(--muted);
    margin-bottom:18px;
}

.check{
    margin:12px 0;
    color:#cbd5e1;
}


/* =====================================================
   PORTFOLIO
===================================================== */

.portfolio-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.portfolio-card{
    height:270px;
    border-radius:16px;
    overflow:hidden;
    border:1px solid var(--border);
    background:linear-gradient(135deg,#1e293b,#111827);
    position:relative;
}

.portfolio-content{
    position:absolute;
    bottom:0;
    width:100%;
    padding:25px;
    background:linear-gradient(transparent,rgba(0,0,0,.9));
}

.portfolio-content p{
    color:#94a3b8;
}


/* =====================================================
   PRICING
===================================================== */

.pricing{
    background:var(--bg2);
}

.pricing-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.price-card{
    padding:35px;
    border:1px solid var(--border);
    border-radius:18px;
    background:#0d1422;
}

.price-card.featured{
    border:2px solid var(--primary);
    transform:scale(1.03);
}

.popular{
    display:inline-block;
    padding:5px 12px;
    background:var(--primary);
    border-radius:20px;
    font-size:12px;
    margin-bottom:15px;
}

.price{
    font-size:40px;
    margin:20px 0;
}

.price span{
    font-size:14px;
    color:var(--muted);
}

.price-card ul{
    list-style:none;
    color:var(--muted);
    margin-bottom:25px;
}

.price-card li{
    margin:12px 0;
}


/* =====================================================
   WHY CHOOSE ME
===================================================== */

.why-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.why-card{
    text-align:center;
    padding:30px 20px;
    border:1px solid var(--border);
    border-radius:15px;
    background:rgba(255,255,255,.025);
}

.why-card .icon{
    font-size:35px;
    margin-bottom:15px;
}

.why-card p{
    color:var(--muted);
    font-size:14px;
}


/* =====================================================
   TESTIMONIALS
===================================================== */

.testimonials{
    background:var(--bg2);
}

.review-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.review{
    padding:30px;
    border:1px solid var(--border);
    border-radius:17px;
    background:#0c1421;
}

.stars{
    color:#fbbf24;
    margin-bottom:15px;
}

.review p{
    color:#cbd5e1;
    margin-bottom:20px;
}

.client{
    font-weight:bold;
}


/* =====================================================
   FAQ
===================================================== */

.faq{
    max-width:800px;
    margin:auto;
}

details{
    border:1px solid var(--border);
    margin-bottom:12px;
    padding:20px;
    border-radius:12px;
    background:rgba(255,255,255,.03);
}

summary{
    cursor:pointer;
    font-weight:bold;
}

details p{
    color:var(--muted);
    margin-top:15px;
}


/* =====================================================
   CONTACT
===================================================== */

.contact-box{
    max-width:800px;
    margin:auto;
    text-align:center;
    padding:60px 30px;
    border:1px solid var(--border);
    border-radius:25px;
    background:linear-gradient(135deg,rgba(124,58,237,.15),rgba(6,182,212,.08));
}

.contact-box h2{
    font-size:45px;
    margin-bottom:15px;
}

.contact-box p{
    color:var(--muted);
    margin-bottom:30px;
}

.contact-buttons{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}


/* =====================================================
   FOOTER
===================================================== */

footer{
    border-top:1px solid var(--border);
    padding:30px 0;
    text-align:center;
    color:var(--muted);
}

.social{
    margin-bottom:15px;
}

.social a{
    margin:0 10px;
}


/* =====================================================
   WHATSAPP
===================================================== */

.whatsapp{
    position:fixed;
    right:20px;
    bottom:20px;
    width:58px;
    height:58px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#25D366;
    color:white;
    border-radius:50%;
    font-size:27px;
    z-index:999;
    box-shadow:0 5px 25px rgba(37,211,102,.35);
}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:900px){

    .services-grid,
    .pricing-grid,
    .portfolio-grid{
        grid-template-columns:1fr 1fr;
    }

    .why-grid{
        grid-template-columns:1fr 1fr;
    }

    .about-grid{
        grid-template-columns:1fr;
    }

}

@media(max-width:650px){

    section{
        padding:70px 0;
    }

    .nav-links{
        display:none;
        position:absolute;
        top:75px;
        left:0;
        width:100%;
        background:#080d18;
        padding:25px;
        flex-direction:column;
    }

    .nav-links.active{
        display:flex;
    }

    .menu-btn{
        display:block;
    }

    .hero h1{
        letter-spacing:-1px;
    }

    .services-grid,
    .pricing-grid,
    .portfolio-grid,
    .why-grid,
    .review-grid{
        grid-template-columns:1fr;
    }

    .price-card.featured{
        transform:none;
    }

    .section-title h2{
        font-size:35px;
    }

    .contact-box h2{
        font-size:35px;
    }

}

</style>
</head>


<body>


<!-- =====================================================
     NAVIGATION
===================================================== -->

<header class="navbar">

<div class="container nav">

    <!-- EDIT HERE: YOUR BRAND NAME -->
